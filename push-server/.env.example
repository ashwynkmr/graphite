# Generate the pair with `npm run keys`. The private key is a secret: never commit it.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://github.com/ashwynkmr/graphite

# Comma-separated; a leading *. matches any subdomain.
ALLOWED_ORIGINS=https://ashwynkmr.github.io

# Leave empty to keep subscriptions in memory (local testing only: a restart loses them).
DATABASE_URL=

PORT=3001
